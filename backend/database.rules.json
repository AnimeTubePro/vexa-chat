{
  /* ═══════════════════════════════════════════════════════════════════
     VEXA CHAT — Firebase Realtime Database Security Rules (v2.1)
     ⚠️ DEPLOY SE PEHLE: Firebase Console → Realtime Database → Rules में
        मौजूदा rules का BACKUP copy रख लो (Export JSON)।
     ⚠️ यह rules existing paths + नए upgrade paths — दोनों cover करते हैं।
     NOTE: recoveryPrivate अब client को कभी नहीं खुलेगा (spec security fix) —
        पुराने client code के try/catch इसे gracefully handle कर लेते हैं।
     ═══════════════════════════════════════════════════════════════════ */
  "rules": {
    ".read": false,
    ".write": false,

    /* ── Profiles: logged-in users पढ़ सकते हैं (chat/feed के लिए ज़रूरी) ── */
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "role":       { ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('usernameChangedAt').val() === undefined" },
        "banned":     { ".write": false },
        "verified":   { ".write": false },
        "publicUserId": { ".write": "auth != null && auth.uid === $uid" },
        "publicUserIdAt": { ".write": "auth != null && auth.uid === $uid" },
        "security":   { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "securityEvents": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "devices":    { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "sessions":   { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "notifications": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null"
        },
        "recovery":   { ".write": "auth != null && auth.uid === $uid" },
        "groups":     { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "chats":      { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "$rest": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    /* ── Username indexes ── */
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "reservedUsernames": { ".read": "auth != null", ".write": false },

    /* ── ⚡UPGRADE: numeric public IDs — atomic, unique ── */
    "publicIdMeta": {
      "counter": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "publicIds": {
      ".read": "auth != null",
      "$num": {
        ".write": "auth != null && !data.exists() && newData.isString()",
        ".validate": "newData.val() === auth.uid"
      }
    },

    /* ── 🔒 SECURITY FIX: recoveryPrivate — CLIENT को कोई access नहीं (Admin SDK बायपास करता है) ── */
    "recoveryPrivate": { ".read": false, ".write": false },

    /* ── recoveryCheck — hashes only (recovery flow public read needs) ── */
    "recoveryCheck": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    /* ── ⚡UPGRADE: single-use hashed recovery codes — सिर्फ owner; verify server-side होता है ── */
    "recoveryCodes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /* ── Recovery requests — root list sirf OWNER (staff panel); per-uid: self + owner ── */
    "recoveryRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /* ── Help requests — login se PEHLE wali reports (v2.3)
          write: koi bhi (logged-out user bhi Help Center se report bhej sakta hai)
          read:  sirf staff (owner/admin/moderator)
          NOTE: ye recoveryPrivate ko TOUCH nahi karta — alag node hai ── */
    "helpRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator')",
      "$rid": {
        ".write": true,
        ".validate": "newData.hasChildren(['type','username','at'])",
        "type": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "detail": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" }
      }
    },

    /* ── Web login codes ── */
    "webLogin": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.val().uid === auth.uid)"
      }
    },

    /* ── 1:1 chats & messages — participants only ── */
    "chats": {
      ".read": "auth != null",
      "$cid": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('participants').child(auth.uid).exists())",
        "unread": {
          "$uid": { ".write": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()" }
        }
      }
    },
    "messages": {
      "$cid": {
        ".read": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()"
      }
    },
    "typing": {
      "$cid": {
        ".read": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()",
        ".write": "auth != null"
      }
    },

    /* ── ⚡UPGRADE: GROUPS — members-only reads, role-checked writes ── */
    "groups": {
      ".read": "auth != null",
      "$gid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() && newData.child('members').child(auth.uid).child('role').val() === 'owner') || (auth != null && data.child('members').child(auth.uid).child('role').val() === 'owner')",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner')"
          }
        },
        "unread": {
          "$uid": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" }
        },
        "photo":   { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "name":    { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "description": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "lastMessage": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "lastSender":  { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "lastSenderName": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "updatedAt":   { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "memberCount": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" }
      }
    },
    "groupMessages": {
      "$gid": {
        ".read": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()"
      }
    },
    "groupInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },

    /* ── Presence / local (existing behaviour) ── */
    "presence": {
      "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" }
    },
    "localPresence": {
      ".read": "auth != null",
      "$cell": { "$uid": { ".write": "auth != null && auth.uid === $uid" } }
    },

    /* ── Calls / games (existing) ── */
    "calls": {
      ".read": "auth != null",
      "$callId": { ".write": "auth != null" }
    },
    "gamesAll": {
      ".read": "auth != null",
      "$gameId": { ".write": "auth != null" }
    },

    /* ── Posts / likes / comments (existing) ── */
    "posts": {
      ".read": "auth != null",
      "$pid": { ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)" }
    },
    "likes": {
      ".read": "auth != null",
      "$pid": { ".write": "auth != null" }
    },
    "comments": {
      ".read": "auth != null",
      "$pid": { ".write": "auth != null" }
    },
    "reports": {
      ".read": "auth != null && ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val())",
      ".write": "auth != null"
    },

    /* ── ⚡UPGRADE v2.2: STAFF INDEX — Support page ka staff list ──
       staff khud apni entry likhta hai (login pe auto-sync);
       rules guarantee: sirf owner/admin/moderator hi likh sakta hai ── */
    "staffIndex": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (root.child('users').child($uid).child('role').val() === 'owner' || root.child('users').child($uid).child('role').val() === 'admin' || root.child('users').child($uid).child('role').val() === 'moderator')"
      }
    },

    /* ── ⚡UPGRADE v2.2: SUPPORT TICKETS — user banata hai, staff jawab deta hai ── */
    "supportTickets": {
      ".read": "auth != null && ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val())",
      ".indexOn": "uid",
      "$tid": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val()))",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val()))"
      }
    },

    /* ── ⚡UPGRADE v2.2: APP CONFIG — support email (staff panel se set hota hai) ── */
    "config": {
      "support": {
        ".read": "auth != null",
        ".write": "auth != null && ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val())"
      }
    },

    /* ── Version (staff write) ── */
    "versionApp": {
      ".read": "auth != null",
      ".write": "auth != null && ['owner','admin','moderator'].hasChild(root.child('users').child(auth.uid).child('role').val())"
    },

    /* ── Recovery attempt throttle (server-only) ── */
    "securityRecoveryAttempts": { ".read": false, ".write": false }
  }
}
