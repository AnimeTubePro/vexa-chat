{
  /* ═══════════════════════════════════════════════════════════════════
     VEXA CHAT — Firebase Realtime Database Security Rules (v3.1 SECURE)
     ═══════════════════════════════════════════════════════════════════
     DESIGN (owner-panel-first):
       • Sensitive user data RESTRUCTURED out of users/{uid}:
           users/{uid}/recovery          -> vaultRecovery/{uid}
           users/{uid}/security+events   -> secData/{uid}
           users/{uid}/devices+sessions  -> devData/{uid}
           users/{uid}/chatLocks         -> chatLocks/{uid}
           users/{uid}/helpChat          -> helpChats/{uid}
           users/{uid}/notifications     -> notifs/{uid}
         Purana data login par auto-migrate ho jata hai (client Auth.migratePrivateNodes).
       • users/{uid} FULL read: sirf khud + staff panel. Dusre users sirf
         PUBLIC profile fields (username/displayName/photo/bio/vip/verified/
         role/banned/posts/followers/following/settings) read kar sakte hain.
       • role self-grant REMOVE — sirf OWNER likh sakta hai.
       • chats/groups/calls/messages: participants-only (top-level read HATA diya
         — RTDB cascade wale leak fix).
       • webLogin codes ab SHA-256 hash keys ke saath — enumeration impossible.
       • hackReports: plaintext codes fields BANNED (validate:false).
       • recoveryPrivate: INTENTIONALLY unchanged (plaintext password sync
         owner panel ke liye rakha gaya hai — product decision v3.1).
     DEPLOY: firebase deploy --only database  (ya Console me paste)
     ═══════════════════════════════════════════════════════════════════ */
  "rules": {
    ".read": false,
    ".write": false,

    /* ── USERS — profile full-read auth users ke liye; SENSITIVE cheezein
          (email/dob/chats-index/callHistory/recovery/security/devices/helpChat/
          notifications) is node se BAHAR ho chuki hain (neeche wale nodes) ── */
    "users": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",

        /* PUBLIC profile — sab logged-in users (chat/feed ke liye zaroori) */
        "username":         { ".read": "auth != null" },
        "displayName":      { ".read": "auth != null" },
        "profilePhoto":     { ".read": "auth != null" },
        "bio":              { ".read": "auth != null" },
        "vip":              { ".read": "auth != null", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },
        "verified":         { ".read": "auth != null", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },
        "banned":           { ".read": "auth != null", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },
        "role":             { ".read": "auth != null", ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'" },
        "publicUserId":     { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" },
        "publicUserIdAt":   { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" },
        "createdAt":        { ".read": "auth != null" },
        "appVer":           { ".read": "auth != null" },
        "profileDesign":    { ".read": "auth != null" },
        "usernameChangedAt":{ ".read": "auth != null" },
        "lastLoginAt":      { ".read": "auth != null" },

        /* Social graph — public (Instagram jaisa) */
        "followers":        { ".read": "auth != null", ".write": "auth != null" },
        "following":        { ".read": "auth != null", ".write": "auth != null" },
        "posts":            { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },
        "postCount":        { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },

        /* Settings — privacy perms cross-user check (Privacy.check) ke liye readable */
        "settings":         { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" },
        /* privacy perms + block/mute graph — dusre user ke liye check karna zaroori */
        "privacy":          { ".read": "auth != null" },
        "blocks":           { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" },
        "muted":            { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" },

        /* PRIVATE — sirf khud */
        "muted":            { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "blocks":           { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "restrictions":     { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "saved":            { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "archived":         { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "followRequests":   { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" },
        "social":           { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "callHistory":      { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" },
        "chats":            { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" },
        "groups":           { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" },
        "gameStats":        { ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')", ".write": "auth != null && auth.uid === $uid" },

        "$other": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    /* ── PRIVATE NODES (v3.1) — self (+owner jahan panel zaroori hai) ── */
    "vaultRecovery": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "secData": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    /* chat index (kaun kisse chat karta hai) — sirf owner padh sakta hai,
       likhna dono participants karte hain */
    "chatIdx": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    /* call history — sirf owner padh sakta hai, likhna caller/callee karte hain */
    "callIdx": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "devData": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chatLocks": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "helpChats": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
      }
    },

    /* ── NOTIFICATIONS — self-only read; koi bhi bhej sakta hai par fields validated ── */
    "notifs": {
      ".indexOn": "read",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['type','at'])",
        "type":     { ".validate": "newData.isString() && newData.val().length <= 30" },
        "title":    { ".validate": "newData.isString() && newData.val().length <= 90" },
        "body":     { ".validate": "newData.isString() && newData.val().length <= 200" },
        "text":     { ".validate": "newData.isString() && newData.val().length <= 200" },
        "from":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "fromName": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "read":     { ".validate": "newData.isBoolean()" },
        "at":       { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": true }
      }
    },

    /* ── Username indexes ── */
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "reservedUsernames": { ".read": "auth != null", ".write": false },

    /* ── Numeric public IDs ── */
    "publicIdMeta": {
      "counter": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "publicIds": {
      ".read": "auth != null",
      "$num": {
        ".write": "auth != null && !data.exists() && newData.isString()",
        ".validate": "newData.val() === auth.uid"
      }
    },

    /* ═══ VAULT v1.0 RECOVERY NODES ═══
       recoveryPrivate: INTENTIONALLY unchanged (v3.1 product decision —
       plaintext password owner panel ke liye). */
    "recoveryPrivate": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')"
      }
    },
    "recoveryVaults": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['backupId'])",
        "backupId":  { ".validate": "newData.isString() && newData.val().matches(/^vlt_[A-Za-z0-9]{10,24}$/)" },
        "keyVersion":{ ".validate": "newData.isNumber()" },
        "accountFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "vaultVersion": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "status":    { ".validate": "newData.isString() && newData.val().length <= 12" },
        "driveBound":{ ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "lastBackupAt": { ".validate": "newData.isNumber()" },
        "viaServer": { ".validate": "newData.isBoolean()" },
        "⚠secret": { ".validate": false }, "⚠password": { ".validate": false }, "⚠key": { ".validate": false },
        "$other":   { ".validate": true }
      }
    },
    "recoveryKeyMetadata": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['keyVersion'])",
        "keyVersion": { ".validate": "newData.isNumber()" },
        "kdf":       { ".validate": "newData.isString() && newData.val().length <= 40" },
        "salt":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "verifier":  { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "viaServer": { ".validate": "newData.isBoolean()" },
        "⚠key": { ".validate": false }, "⚠secret": { ".validate": false },
        "$other":   { ".validate": true }
      }
    },
    "recoveryBackupStatus": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['backupId'])",
        "backupId":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "fileHash":  { ".validate": "newData.isString() && newData.val().length <= 64" },
        "driveFileId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "versions":  { ".validate": "newData.isNumber()" },
        "integrityVerified": { ".validate": "newData.isBoolean()" },
        "uploadedAt":{ ".validate": "newData.isNumber()" },
        "$other":   { ".validate": true }
      }
    },

    /* ── recoveryRequests — query-scoped self read + staff ── */
    "recoveryRequests": {
      ".read": "auth != null && (((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')) || (query.orderByChild === 'tempUid' && query.equalTo === auth.uid))",
      ".indexOn": "tempUid",
      "$reqId": {
        ".write": "auth != null && ((!data.exists() && newData.child('tempUid').val() === auth.uid) || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')) || data.child('tempUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['tempUid','mode','status'])",
        "reqId":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "tempUid":   { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 60" },
        "tempUsername": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "origUid":   { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 60" },
        "origUsername": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "origEmail": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "origFingerprint": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "backupId":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "keyVersion":{ ".validate": "newData.isNumber()" },
        "mode":      { ".validate": "newData.isString() && ((newData.val() === 'full_migration') || (newData.val() === 'selective_migration') || (newData.val() === 'restoration'))" },
        "cats":      { ".validate": "newData.hasChildren() || newData.val() === null" },
        "reason":    { ".validate": "newData.isString() && newData.val().length <= 300" },
        "integrityStatus": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "ownershipStatus": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "registryMatch":   { ".validate": "newData.isBoolean()" },
        "viaServer": { ".validate": "newData.isBoolean()" },
        "vaultVerdict": { ".validate": "newData.hasChildren()" },
        "status":    { ".validate": "newData.isString() && ((newData.val() === 'pending') || (newData.val() === 'verifying') || (newData.val() === 'admin_recommended') || (newData.val() === 'owner_pending') || (newData.val() === 'approved') || (newData.val() === 'in_progress') || (newData.val() === 'completed') || (newData.val() === 'rejected') || (newData.val() === 'expired') || (newData.val() === 'cancelled'))" },
        "rejectReason": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "adminNote": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "verifiedBy":{ ".validate": "newData.isString() && newData.val().length <= 40" },
        "escalatedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "decidedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "requestedAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "deviceTrusted": { ".validate": "newData.isBoolean()" },
        "devName":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other":   { ".validate": true }
      }
    },
    "recoveryApprovals": {
      ".read": "auth != null && (((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')) || query.orderByChild === 'reqId')",
      "$reqId": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".validate": "newData.hasChildren(['type','approverRole'])",
        "reqId":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "type":      { ".validate": "newData.isString() && newData.val().length <= 24" },
        "decision":  { ".validate": "newData.isString() && newData.val().length <= 16" },
        "approverUid": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "approverRole": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "method":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "jobId":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "viaServer":{ ".validate": "newData.isBoolean()" },
        "viaFallback": { ".validate": "newData.isBoolean()" },
        "at":        { ".validate": "newData.isNumber()" },
        "$other":   { ".validate": false }
      }
    },
    "recoveryJobs": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".indexOn": "reqId",
      "$jobId": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".validate": "newData.hasChildren(['reqId','mode'])",
        "reqId":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "oldUid":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "newUid":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "oldUsername": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "newUsername": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "mode":      { ".validate": "newData.isString() && ((newData.val() === 'full_migration') || (newData.val() === 'selective_migration') || (newData.val() === 'restoration'))" },
        "cats":      { ".validate": "newData.hasChildren() || newData.val() === null" },
        "status":    { ".validate": "newData.isString() && newData.val().length <= 22" },
        "checkpoint":{ ".validate": "newData.isString() && newData.val().length <= 16" },
        "checkpointIndex": { ".validate": "newData.isNumber()" },
        "stats":     { ".validate": "newData.hasChildren()" },
        "verification": { ".validate": "newData.hasChildren()" },
        "error":     { ".validate": "newData.isString() && newData.val().length <= 200" },
        "ownerUid":  { ".validate": "newData.isString() && newData.val().length <= 60" },
        "viaServer":{ ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "finishedAt":{ ".validate": "newData.isNumber()" },
        "$other":   { ".validate": true }
      }
    },
    "recoveryAuditLogs": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$logId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['at','action','actor'])",
        "at":        { ".validate": "newData.isNumber()" },
        "action":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "actor":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "actorRole": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "targetType":{ ".validate": "newData.isString() && newData.val().length <= 24" },
        "targetId":  { ".validate": "newData.isString() && newData.val().length <= 60" },
        "detail":    { ".validate": "newData.isString() && newData.val().length <= 300" },
        "$other":   { ".validate": true }
      }
    },

    /* ── recoveryCheck — hashes; self + staff read (PUBLIC read HATA diya) ── */
    "recoveryCheck": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "recoveryCodes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    /* ── dataRecoveryApps — applicant + staff ── */
    "dataRecoveryApps": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".indexOn": "newUid",
      "$appId": {
        ".read": "auth != null && (data.child('newUid').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && ((!data.exists() && newData.child('newUid').val() === auth.uid) || data.child('newUid').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".validate": "newData.hasChildren(['oldUid','newUid','status'])",
        "oldUid":     { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 60" },
        "oldUsername":{ ".validate": "newData.isString() && newData.val().length <= 20" },
        "newUid":     { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 60" },
        "newUsername":{ ".validate": "newData.isString() && newData.val().length <= 20" },
        "newEmail":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "oldEmail":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "oldDob":     { ".validate": "newData.isString() && newData.val().length <= 12" },
        "verifiedData": { ".validate": "newData.isBoolean()" },
        "viaServer":  { ".validate": "newData.isBoolean()" },
        "status":     { ".validate": "newData.isString() && ((newData.val() === 'pending') || (newData.val() === 'verified') || (newData.val() === 'completed') || (newData.val() === 'rejected'))" },
        "rejectReason":{ ".validate": "newData.isString() && newData.val().length <= 120" },
        "device":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "appVer":     { ".validate": "newData.isString() && newData.val().length <= 12" },
        "createdAt":  { ".validate": "newData.isNumber()" },
        "updatedAt":  { ".validate": "newData.isNumber()" },
        "verifiedAt": { ".validate": "newData.isNumber()" },
        "verifiedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "rejectedAt": { ".validate": "newData.isNumber()" },
        "rejectedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "completedAt":{ ".validate": "newData.isNumber()" },
        "completedBy":{ ".validate": "newData.isString() && newData.val().length <= 40" },
        "sentPassword":{ ".validate": "newData.isBoolean()" },
        "$other":    { ".validate": false }
      }
    },

    /* ── hackReports — PUBLIC create-only, plaintext CODES AB ALLOWED NAHI ── */
    "hackReports": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$rid": {
        ".write": "!data.exists() || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".validate": "newData.hasChildren(['username','status','at'])",
        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "dob":      { ".validate": "newData.isString() && newData.val().length <= 12" },
        "mainCode": { ".validate": false },
        "secCode":  { ".validate": false },
        "detail":   { ".validate": "newData.isString() && newData.val().length <= 300" },
        "device":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "byUid":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "reporterNew":{ ".validate": "newData.isString() && newData.val().length <= 20" },
        "status":   { ".validate": "newData.isString() && newData.val().length <= 12" },
        "at":       { ".validate": "newData.isNumber()" },
        "resolvedAt":{ ".validate": "newData.isNumber()" },
        "resolvedBy":{ ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other":  { ".validate": false }
      }
    },

    /* ── helpRequests — pre-login public write, staff read ── */
    "helpRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator')",
      "$rid": {
        ".write": true,
        ".validate": "newData.hasChildren(['type','username','at'])",
        "type": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "detail": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" }
      }
    },

    /* ═══ CHATS — participants-only (top-level world read REMOVE — cascade leak fix) ═══ */
    "chats": {
      "$cid": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('participants').child(auth.uid).exists()) || data.child('participants').child(auth.uid).exists())",
        "participants": {
          "$p": { ".validate": "newData.val() === true" }
        },
        "unread": {
          "$uid": { ".write": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()" }
        }
      }
    },
    "messages": {
      "$cid": {
        ".read": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()",
        "$mid": {
          ".validate": "newData.hasChildren(['senderId','type','createdAt'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "type":     { ".validate": "newData.isString() && newData.val().length <= 16" },
          "text":     { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "fileName": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "mimeType": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "size":     { ".validate": "newData.isNumber()" },
          "fileId":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "createdAt":{ ".validate": "newData.isNumber()" },
          "$other":   { ".validate": true }
        }
      }
    },
    "typing": {
      "$cid": {
        ".read": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($cid).child('participants').child(auth.uid).exists()"
      }
    },

    /* ═══ GROUPS — members-only read/write (self-join sirf invite ke saath) ═══ */
    "groups": {
      "$gid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).child('role').val() === 'owner') || data.child('members').child(auth.uid).child('role').val() === 'owner')",
        "members": {
          "$uid": {
            ".write": "auth != null && ((root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner') || (auth.uid === $uid && !newData.exists() && root.child('groupInvites').child(auth.uid).child($gid).exists()) || (auth.uid === $uid && data.exists() && !newData.exists()))"
          }
        },
        "unread": {
          "$uid": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" }
        },
        "photo":   { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "name":    { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "description": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).child('role').val() === 'owner'" },
        "lastMessage": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "lastSender":  { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "lastSenderName": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "updatedAt":   { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" },
        "memberCount": { ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()" }
      }
    },
    "groupMessages": {
      "$gid": {
        ".read": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        "$mid": {
          ".validate": "newData.hasChildren(['senderId','createdAt'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text":     { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "createdAt":{ ".validate": "newData.isNumber()" },
          "$other":   { ".validate": true }
        }
      }
    },
    "groupInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null",
        "$gid": {
          ".validate": "newData.hasChildren(['from','at'])",
          "from": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "at":   { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        }
      }
    },

    /* ── Presence / local (existing behaviour) ── */
    "presence": {
      "$uid": { ".read": "auth != null", ".write": "auth != null && auth.uid === $uid" }
    },
    "localPresence": {
      ".read": "auth != null",
      "$cell": { "$uid": { ".write": "auth != null && auth.uid === $uid" } }
    },

    /* ═══ CALLS — caller/peer-only read+write (world-readable calls FIX) ═══ */
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('caller').val() === auth.uid || data.child('peer').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('caller').val() === auth.uid) || data.child('caller').val() === auth.uid || data.child('peer').val() === auth.uid)"
      }
    },

    /* ═══ GAMES — players-only (query-scoped lobby read apne invites ke liye) ═══ */
    "gamesAll": {
      ".read": "auth != null && ((query.orderByChild === 'p1' && query.equalTo === auth.uid) || (query.orderByChild === 'p2' && query.equalTo === auth.uid))",
      "$gameId": {
        ".read": "auth != null && (data.child('p1').val() === auth.uid || data.child('p2').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('p1').val() === auth.uid) || data.child('p1').val() === auth.uid || data.child('p2').val() === auth.uid)",
        ".validate": "newData.hasChildren(['type','p1','p2','status'])",
        "type":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "p1":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "p2":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "turn":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "state":  { ".validate": "true" },
        "at":     { ".validate": "newData.isNumber()" },
        "$other": { ".validate": true }
      }
    },

    /* ── Posts / likes / comments (social) ── */
    "posts": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || data.child('userId').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".validate": "newData.hasChildren(['userId','createdAt'])",
        "userId":   { ".validate": "newData.val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))" },
        "text":     { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "createdAt":{ ".validate": "newData.isNumber()" },
        "$other":   { ".validate": true }
      }
    },
    "likes": {
      ".read": "auth != null",
      "$pid": { ".write": "auth != null" }
    },
    "comments": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null",
        "$cmid": {
          ".validate": "newData.hasChildren(['uid','text','at'])",
          "uid":  { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "at":   { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        }
      }
    },
    "reels": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || data.child('userId').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        "likes":       { ".write": "auth != null" },
        "likeCount":   { ".write": "auth != null" },
        "commentCount":{ ".write": "auth != null" }
      }
    },
    "reelComments": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null",
        "$cmid": {
          ".validate": "newData.hasChildren(['uid','text','at'])",
          "uid":  { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "at":   { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        }
      }
    },
    "reports": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".write": "auth != null"
    },
    "promotionRequests": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$rid": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))"
      }
    },

    /* ── Staff index / tickets / config / version ── */
    "staffIndex": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && (root.child('users').child($uid).child('role').val() === 'owner' || root.child('users').child($uid).child('role').val() === 'admin' || root.child('users').child($uid).child('role').val() === 'moderator')) || root.child('users').child(auth.uid).child('role').val() === 'owner')"
      }
    },
    "supportTickets": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".indexOn": "uid",
      "$tid": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator')))"
      }
    },
    "config": {
      "support": {
        ".read": "auth != null",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
      },
      "promotion": {
        ".read": "auth != null",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
      }
    },
    "versionApp": {
      ".read": "auth != null",
      ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
    },

    /* ── Staff chat / panel security / verdicts ── */
    "staffChat": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      "$mid": {
        ".validate": "newData.hasChildren(['uid','name','text','at'])",
        "uid":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "role": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "at":   { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "panelSecurity": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
    },
    "recoveryTemp": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
      }
    },
    "recoveryVerdicts": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))",
      ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'owner') || (root.child('users').child(auth.uid).child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('role').val() === 'moderator'))"
    },

    /* ── Web login codes — keys ab SHA-256(code) hain (enumeration impossible);
          write: sirf apna uid; read: sirf code-hash jaanne wala (typed code) ── */
    "webLogin": {
      "$codeHash": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','email','exp'])",
        "uid":   { ".validate": "newData.val() === auth.uid" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "exp":   { ".validate": "newData.isNumber()" },
        "used":  { ".validate": "newData.isBoolean()" },
        "usedAt":{ ".validate": "newData.isNumber()" },
        "device":{ ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other":{ ".validate": false }
      }
    },

    /* ── Recovery attempt throttle (server-only) ── */
    "securityRecoveryAttempts": { ".read": false, ".write": false }
  }
}
